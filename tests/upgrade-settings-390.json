{
  "viewport": {
    "width": 390,
    "height": 844
  },
  "steps": [
    {
      "type": "wait",
      "durationMs": 1500
    },
    {
      "type": "ui",
      "action": "click",
      "target": "#view-select:visible, body:not(:has(#view-select:visible))"
    },
    {
      "type": "ui",
      "action": "click",
      "target": "li[data-device=WebpageFullScreen]:visible, body:not(:has(li[data-device=WebpageFullScreen]:visible))"
    },
    {
      "type": "wait_ready"
    },
    {
      "type": "wait_for_state",
      "expect": {
        "revision": "upgrade-settings-v1",
        "horseFrames": 144,
        "equipment": {
          "typeCount": 4
        },
        "preRaceFrames": 66,
        "preAudio": {
          "loaded": 5
        }
      },
      "timeoutMs": 5000
    },
    {
      "type": "get_state",
      "required": true
    },
    {
      "type": "pointer",
      "action": "touch_tap",
      "x": 269,
      "y": 700
    },
    {
      "type": "wait_for_state",
      "expect": {
        "dialog": "settings",
        "paused": true
      },
      "timeoutMs": 5000
    },
    {
      "type": "get_state",
      "required": true
    },
    {
      "type": "pointer",
      "action": "touch_tap",
      "x": 111,
      "y": 474
    },
    {
      "type": "wait_for_state",
      "expect": {
        "settings": {
          "master": 0.9
        }
      },
      "timeoutMs": 5000
    },
    {
      "type": "pointer",
      "action": "touch_tap",
      "x": 111,
      "y": 645
    },
    {
      "type": "wait_for_state",
      "expect": {
        "settings": {
          "muted": true
        }
      },
      "timeoutMs": 5000
    },
    {
      "type": "pointer",
      "action": "touch_tap",
      "x": 278,
      "y": 645
    },
    {
      "type": "wait_for_state",
      "expect": {
        "settings": {
          "reducedMotion": true
        },
        "activeReducedMotion": false
      },
      "timeoutMs": 5000
    },
    {
      "type": "screenshot",
      "label": "upgrade-settings-changed"
    },
    {
      "type": "pointer",
      "action": "touch_tap",
      "x": 333,
      "y": 198
    },
    {
      "type": "wait_for_state",
      "expect": {
        "dialog": "none",
        "paused": false
      },
      "timeoutMs": 5000
    },
    {
      "type": "screenshot",
      "label": "upgrade-settings-closed"
    }
  ]
}